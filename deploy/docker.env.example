# Variáveis do docker-compose do claude-guardian.
# Copie para .guardian.env e preencha:
#   cp deploy/docker.env.example .guardian.env
#
# Gere chaves fortes com:  openssl rand -hex 24

# Senha do PostgreSQL interno do compose
POSTGRES_PASSWORD=

# Token de acesso ao dashboard (admin)
GUARDIAN_DASHBOARD_TOKEN=

# Chave compartilhada usada pelos agentes nas máquinas dos funcionários
GUARDIAN_AGENT_KEY=

# Porta exposta no host (opcional, padrão 7734)
#GUARDIAN_PORT=7734
